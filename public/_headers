# Cloudflare Pages Edge Caching & Performance Headers

# Security & Global Standards
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Hashed assets produced by Vite (Immutable 1-year cache)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Standalone games (1-week cache with stale-while-revalidate)
/games/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Favicon and static assets
/favicon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/brand-logo*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og-devkitra.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML entry points (always revalidate to ensure instantaneous deployment rollouts)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

